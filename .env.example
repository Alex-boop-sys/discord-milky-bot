# Обязательный токен Discord-бота
DISCORD_TOKEN=вставьте_токен_бота

# Ключи AI-провайдеров (текущая конфигурация проверяет наличие всех значений)
GROQ_API_KEY=вставьте_ключ
OPENROUTER_API_KEY=вставьте_ключ
CLOUDFLARE_ACCOUNT_ID=вставьте_ID_аккаунта
CLOUDFLARE_API_TOKEN=вставьте_токен
ZAI_API_KEY=вставьте_ключ

# Необязательные Discord ID владельца и совладельца для root# команд
OWNER_ID=
CO_OWNER_ID=

# --- Серверы и каналы: все ID хранятся только здесь, в коде их нет ---
# Как узнать ID: Discord -> Настройки -> Расширенные -> включить «Режим разработчика»,
# затем ПКМ по серверу или каналу -> «Копировать ID». Списки - ID через запятую: 111,222

# Основной сервер: под его ID хранится общий баланс Геофруктов.
# ВАЖНО: если экономика уже работала, оставьте здесь тот же ID, что был раньше,
# иначе накопленные Геофрукты "пропадут" (бот начнёт считать с нуля).
MAIN_GUILD_ID=

# Серверы, где бот работает. С остальных он сразу выходит.
# Пусто = только MAIN_GUILD_ID. Если не задано ничего, ограничений нет.
ALLOWED_GUILD_IDS=

# Серверы с экономикой Геофруктов. Пусто = только MAIN_GUILD_ID.
ECONOMY_GUILD_IDS=

# Каналы утреннего приветствия. Пусто = приветствия не отправляются.
GREETINGS_CHANNEL_IDS=
